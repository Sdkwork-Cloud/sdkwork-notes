{
  "name": "sdkwork-notes-workspace",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "dependencies": {
    "@sdkwork/app-topology": "file:../sdkwork-app-topology"
  },
  "scripts": {
    "notes:dev": "node scripts/notes-dev.mjs --target browser --hosting self-hosted",
    "notes:dev:cloud": "node scripts/notes-dev.mjs --target browser --hosting cloud-hosted",
    "notes:dev:desktop": "node scripts/notes-dev.mjs --target desktop --hosting self-hosted",
    "notes:dev:desktop:cloud": "node scripts/notes-dev.mjs --target desktop --hosting cloud-hosted",
    "notes:api-server": "node scripts/run-notes-api-server.mjs",
    "topology:validate": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json",
    "gateway:cloud:matrix": "node scripts/print-gateway-package-matrix.mjs --profile platform-config-bundle",
    "gateway:cloud:bundle": "node scripts/gateway-cloud-bundle.mjs bundle",
    "gateway:cloud:bundle:validate": "node scripts/gateway-cloud-bundle.mjs validate",
    "gateway:matrix": "node scripts/print-gateway-package-matrix.mjs --profile all",
    "test:topology": "node --test --experimental-test-isolation=none scripts/verify-notes-topology.test.mjs",
    "test:topology-baggage": "node --test scripts/dev/sdkwork-notes-topology-baggage.test.mjs",
    "test:contracts": "node --test --experimental-test-isolation=none scripts/verify-notes-contract-foundation.test.mjs && node --test --experimental-test-isolation=none scripts/verify-notes-rust-service-skeleton.test.mjs && node --test --experimental-test-isolation=none scripts/verify-notes-standard-architecture.test.mjs",
    "test": "pnpm topology:validate && pnpm test:topology && pnpm test:topology-baggage && pnpm test:contracts",
    "verify": "cargo test --workspace && pnpm test",
    "db:materialize:contract": "node tools/materialize_notes_database_contract.mjs",
    "db:validate": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "db:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan",
    "db:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init",
    "db:migrate": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . migrate",
    "db:seed": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . seed",
    "db:status": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . status",
    "db:drift": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift",
    "db:drift:check": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift-check",
    "db:bootstrap": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . bootstrap",
    "test:contract:database": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root ."
  }
}
