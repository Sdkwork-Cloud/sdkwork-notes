{
  "name": "sdkwork-notes-workspace",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "dependencies": {
    "@sdkwork/app-topology": "file:../sdkwork-app-topology"
  },
  "scripts": {
    "dev": "node scripts/notes-dev.mjs --runtime-target browser --database postgres --service-layout unified-process --deployment-profile standalone",
    "dev:browser": "node scripts/notes-dev.mjs --runtime-target browser --database postgres --service-layout unified-process --deployment-profile standalone",
    "dev:browser:cloud": "node scripts/notes-dev.mjs --runtime-target browser --database postgres --service-layout split-services --deployment-profile cloud",
    "dev:browser:split-services": "node scripts/notes-dev.mjs --runtime-target browser --database postgres --service-layout split-services --deployment-profile standalone",
    "dev:desktop": "node scripts/notes-dev.mjs --runtime-target desktop --database postgres --service-layout unified-process --deployment-profile standalone",
    "dev:desktop:cloud": "node scripts/notes-dev.mjs --runtime-target desktop --database postgres --service-layout split-services --deployment-profile cloud",
    "start:api-server": "node scripts/run-notes-api-server.mjs",
    "build": "cargo build --workspace",
    "test": "pnpm topology:validate && pnpm test:topology && pnpm test:topology-baggage && pnpm test:contracts",
    "check": "cargo check --workspace && pnpm check:pnpm-script-standard && pnpm check:architecture-alignment && pnpm topology:validate && pnpm db:validate && pnpm api:check",
    "verify": "cargo test --workspace && pnpm test",
    "clean": "cargo clean",
    "check:pnpm-script-standard": "node ../sdkwork-specs/tools/check-pnpm-script-standard.mjs --root . --application-code-prefix notes",
    "check:architecture-alignment": "node --test scripts/verify-notes-standard-architecture.test.mjs",
    "api:check": "node tools/notes_sdk_generate.mjs --check",
    "api:materialize": "node scripts/sync-notes-api-framework-metadata.mjs",
    "sdk:check": "node tools/notes_sdk_generate.mjs --check",
    "sdk:generate": "node tools/notes_sdk_generate.mjs",
    "topology:plan": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs plan --root . --spec specs/topology.spec.json",
    "topology:validate": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json",
    "gateway:matrix:cloud": "node scripts/print-gateway-package-matrix.mjs --profile platform-config-bundle",
    "gateway:bundle:cloud": "node scripts/gateway-cloud-bundle.mjs bundle",
    "gateway:bundle:validate:cloud": "node scripts/gateway-cloud-bundle.mjs validate",
    "gateway:matrix": "node scripts/print-gateway-package-matrix.mjs --profile all",
    "test:topology": "node --test --experimental-test-isolation=none scripts/verify-notes-topology.test.mjs",
    "test:topology-baggage": "node --test scripts/dev/sdkwork-notes-topology-baggage.test.mjs",
    "test:contracts": "node --test --experimental-test-isolation=none scripts/verify-notes-contract-foundation.test.mjs && node --test --experimental-test-isolation=none scripts/verify-notes-rust-service-skeleton.test.mjs && node --test --experimental-test-isolation=none scripts/verify-notes-standard-architecture.test.mjs",
    "db:materialize:contract": "node tools/materialize_notes_database_contract.mjs",
    "db:validate": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "db:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan",
    "db:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init",
    "db:migrate": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . migrate",
    "db:seed": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . seed",
    "db:status": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . status",
    "db:drift": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift",
    "db:drift:check": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift-check",
    "db:bootstrap": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . bootstrap",
    "test:contract:database": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root ."
  }
}
