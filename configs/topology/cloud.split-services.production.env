# cloud.split-services.production
SDKWORK_NOTES_DEPLOYMENT_PROFILE=cloud
SDKWORK_NOTES_SERVICE_LAYOUT=split-services
SDKWORK_NOTES_ENVIRONMENT=production
SDKWORK_NOTES_PROFILE_ID=cloud.split-services.production

SDKWORK_NOTES_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8787
SDKWORK_NOTES_APPLICATION_PUBLIC_HTTP_URL=https://notes.sdkwork.com
SDKWORK_API_CLOUD_GATEWAY_BIND=127.0.0.1:3900
SDKWORK_NOTES_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_NOTES_PLATFORM_API_GATEWAY_AUTOSTART=false
SDKWORK_API_CLOUD_GATEWAY_CONFIG=configs/sdkwork-api-cloud-gateway.notes.production.toml

SDKWORK_NOTES_USE_MEMORY_DRIVE=0
SDKWORK_DRIVE_FACADE_URL=https://api.sdkwork.com

SDKWORK_CLAW_DATABASE_ENGINE=postgresql
SDKWORK_CLAW_DATABASE_HOST=db.example.com
SDKWORK_CLAW_DATABASE_PORT=5432
SDKWORK_CLAW_DATABASE_NAME=sdkwork
SDKWORK_CLAW_DATABASE_SCHEMA=public
SDKWORK_CLAW_DATABASE_USERNAME=sdkwork
SDKWORK_CLAW_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/database-password
SDKWORK_CLAW_DATABASE_SSL_MODE=require
SDKWORK_CLAW_DATABASE_MAX_CONNECTIONS=32

VITE_SDKWORK_NOTES_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_NOTES_APPLICATION_PUBLIC_HTTP_URL=https://notes.sdkwork.com
VITE_SDKWORK_NOTES_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=https://api.sdkwork.com
