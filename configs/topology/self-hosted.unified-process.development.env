# Notes topology profile: self-hosted + unified-process + development

SDKWORK_NOTES_HOSTING=self-hosted
SDKWORK_NOTES_SERVICE_LAYOUT=unified-process
SDKWORK_NOTES_ENVIRONMENT=development
SDKWORK_NOTES_PROFILE_ID=self-hosted.unified-process.development

SDKWORK_NOTES_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8787
SDKWORK_NOTES_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8787
SDKWORK_NOTES_DATABASE_URL=sqlite://./.sdkwork/notes/product.db
SDKWORK_NOTES_USE_MEMORY_DRIVE=1

SDKWORK_API_GATEWAY_BIND=127.0.0.1:3900
SDKWORK_NOTES_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_NOTES_PLATFORM_API_GATEWAY_AUTOSTART=false

VITE_SDKWORK_NOTES_HOSTING=self-hosted
VITE_SDKWORK_NOTES_ENVIRONMENT=development
VITE_SDKWORK_NOTES_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8787
VITE_SDKWORK_NOTES_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=http://127.0.0.1:3900
