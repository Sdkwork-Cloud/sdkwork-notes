# cloud.production
SDKWORK_NOTES_DEPLOYMENT_PROFILE=cloud
SDKWORK_NOTES_ENVIRONMENT=production
SDKWORK_NOTES_PROFILE_ID=cloud.production

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_NOTES_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_NOTES_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8787
SDKWORK_NOTES_APPLICATION_PUBLIC_HTTP_URL=https://notes.sdkwork.com
SDKWORK_NOTES_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

SDKWORK_NOTES_USE_MEMORY_DRIVE=0
SDKWORK_DRIVE_FACADE_URL=https://api.sdkwork.com

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/database-password
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=32

VITE_SDKWORK_NOTES_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_NOTES_APPLICATION_PUBLIC_HTTP_URL=https://notes.sdkwork.com
VITE_SDKWORK_NOTES_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=https://api.sdkwork.com

