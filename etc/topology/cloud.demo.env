# cloud.demo — cloud-hosted independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Dedicated PostgreSQL database/schema/user `sdkwork_ai_demo`. No Redis key is declared in this
# repo's profiles; the demo MUST be provisioned with a dedicated Redis logical DB index (or
# `-demo` prefix) so no cache key ever collides with another shared-redis environment.
SDKWORK_NOTES_DEPLOYMENT_PROFILE=cloud
SDKWORK_NOTES_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_NOTES_PROFILE_ID=cloud.demo
SDKWORK_NOTES_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8789
SDKWORK_NOTES_APPLICATION_PUBLIC_HTTP_URL=https://notes-demo.sdkwork.com
SDKWORK_NOTES_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_NOTES_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo PostgreSQL schema on a dedicated demo database.
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_demo
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_demo
SDKWORK_DATABASE_USERNAME=sdkwork_ai_demo
SDKWORK_DATABASE_PASSWORD=sdkworkdemo123
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10
SDKWORK_NOTES_USE_MEMORY_DRIVE=0
SDKWORK_DRIVE_FACADE_URL=https://api-demo.sdkwork.com

VITE_SDKWORK_NOTES_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_NOTES_APPLICATION_PUBLIC_HTTP_URL=https://notes-demo.sdkwork.com
VITE_SDKWORK_NOTES_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=https://api-demo.sdkwork.com
