# SDKWork Notes PC desktop host profile (development example)

[app]
key = "sdkwork-notes-pc-react"
runtime_target = "desktop"
deployment_profile = "standalone"

[window]
title = "SDKWork Notes"
width = 1440
height = 900

[runtime]
environment = "development"
config_profile = "dev"

[database]
engine = "sqlite"
file = "~/.sdkwork/notes/data/notes.sqlite"
max_connections = 1
