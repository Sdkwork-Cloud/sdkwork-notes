          "default": {
            "$ref": "#/components/responses/ProblemDetailResponse"
          }
        },
        "x-sdkwork-owner": "sdkwork-notes",
        "x-sdkwork-api-authority": "sdkwork-notes-open-api",
        "x-sdkwork-domain": "notes",
        "x-sdkwork-resource": "pages",
        "x-sdkwork-permission": "notes.open.pages.write",
        "x-sdkwork-tenant-scope": "tenant",
        "x-sdkwork-data-scope": "organization",
        "x-sdkwork-audit-event": "notes.open.page.update"
