        ],
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PageIdPath"
          },
          {
            "$ref": "#/components/parameters/DriveVersionIdPath"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
