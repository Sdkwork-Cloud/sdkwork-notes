{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "SDKWork Notes Open API",
    "version": "0.1.0",
    "description": "Public integration authority skeleton for SDKWork Notes. Open API exposes Notes business resources through API-key context and does not expose app login/session or Drive storage internals."
  },
  "servers": [
    {
      "url": "/notes/v3/api",
      "description": "SDKWork Notes Open API root"
    }
  ],
  "tags": [
    {
      "name": "notes",
      "description": "AI-native Notes open integration surface."
    }
  ],
  "paths": {
