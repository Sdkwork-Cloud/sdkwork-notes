  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "parameters": {
      "WorkspaceIdQuery": {
        "name": "workspace_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "PageIdPath": {
        "name": "pageId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ExportIdPath": {
        "name": "exportId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "PageQuery": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PageSizeQuery": {
        "name": "page_size",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 20
        }
      },
      "SearchQuery": {
        "name": "q",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 200
        }
      },
      "DriveVersionIdPath": {
        "name": "driveVersionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Drive-owned node version id exposed through the Notes page facade."
      }
    },
    "responses": {
      "ProblemDetailResponse": {
        "description": "Problem detail error.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      }
    },
    "schemas": {
      "FieldError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      },
      "PageInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "pageSize",
          "hasMore"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "Workspace": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "driveSpaceId",
          "lifecycleStatus"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "driveSpaceId": {
            "type": "string"
          },
          "lifecycleStatus": {
            "type": "string"
          }
        }
      },
      "WorkspacePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "pageInfo"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workspace"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        }
      },
      "PageSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "workspaceId",
          "title",
          "driveNodeId",
          "currentDriveVersionNo"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "driveNodeId": {
            "type": "string"
          },
          "currentDriveVersionNo": {
            "type": "string"
          }
        }
      },
      "Page": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PageSummary"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "driveSpaceId",
              "driveUri",
              "contentType",
              "lifecycleStatus",
              "currentDriveVersionId",
              "contentSchemaVersion"
            ],
            "properties": {
              "driveSpaceId": {
                "type": "string"
              },
              "driveUri": {
                "type": "string"
              },
              "currentDriveVersionId": {
                "type": "string"
              },
              "contentType": {
                "type": "string",
                "maxLength": 255
              },
              "contentSchemaVersion": {
                "type": "string",
                "maxLength": 32
              },
              "lifecycleStatus": {
                "type": "string"
              }
            }
          }
        ]
      },
      "PageSummaryPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "pageInfo"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageSummary"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        }
      },
      "PageContent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pageId",
          "driveNodeId",
          "driveVersionNo",
          "contentType",
          "content",
          "driveVersionId",
          "contentSchemaVersion"
        ],
        "properties": {
          "pageId": {
            "type": "string"
          },
          "driveNodeId": {
            "type": "string"
          },
          "driveVersionId": {
            "type": "string"
          },
          "driveVersionNo": {
            "type": "string"
          },
          "contentType": {
            "type": "string",
            "maxLength": 255
          },
          "content": {
            "type": "object",
            "additionalProperties": true
          },
          "contentSchemaVersion": {
            "type": "string",
            "maxLength": 32
          }
        }
      },
      "DriveVersionSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "driveVersionId",
          "driveVersionNo",
          "versionKind",
          "createdAt"
        ],
        "properties": {
          "driveVersionId": {
            "type": "string"
          },
          "driveVersionNo": {
            "type": "string"
          },
